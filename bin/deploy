#!/bin/sh
# Build Radio, install it as ~/.local/bin/radio, and (re)load its two LaunchAgents:
# com.jubishop.radio.run every 15 minutes and com.jubishop.radio.serve always.
# Each run keeps every log in ~/Library/Logs/Radio under 1 MB.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
bin_dir="$HOME/.local/bin"
log_dir="$HOME/Library/Logs/Radio"
agents="$HOME/Library/LaunchAgents"
domain="gui/$(id -u)"

swift build --package-path "$root" -c release
built="$(swift build --package-path "$root" -c release --show-bin-path)/radio"
mkdir -p "$bin_dir" "$log_dir" "$agents"
/usr/bin/install -m 0755 "$built" "$bin_dir/radio.new"
# macOS ties Radio's permission to control Music to its code signature, so
# sign with a stable identity or it asks again after every deploy.
identity=${RADIO_SIGNING_IDENTITY:-$(security find-identity -v -p codesigning | sed -n 's/.*"\(Apple Development: [^"]*\)".*/\1/p' | head -n 1)}
if [ -n "$identity" ]; then
  codesign --force --sign "$identity" --identifier com.jubishop.radio "$bin_dir/radio.new"
else
  echo "No Apple Development signing identity found; macOS may ask again to let Radio control Music." >&2
fi
mv -f "$bin_dir/radio.new" "$bin_dir/radio"

# The checkout's .env, which Git ignores, can set RADIO_DASHBOARD_URL, where
# alerts link, so a private address stays out of this public repository.
dashboard_url=""
if [ -f "$root/.env" ]; then
  dashboard_url=$(sed -n 's/^RADIO_DASHBOARD_URL=//p' "$root/.env" | tail -n 1 | sed "s/^[\"']//; s/[\"']\$//")
fi
environment=""
if [ -n "$dashboard_url" ]; then
  environment="  <key>EnvironmentVariables</key>
  <dict>
    <key>RADIO_DASHBOARD_URL</key>
    <string>$(printf '%s' "$dashboard_url" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')</string>
  </dict>
"
fi

# write_agent LABEL SCHEDULE_XML ARGUMENT...
write_agent() {
  label=$1
  schedule=$2
  shift 2
  arguments=""
  for argument in "$@"; do
    arguments="$arguments    <string>$argument</string>
"
  done
  cat > "$agents/$label.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$bin_dir/radio</string>
$arguments  </array>
$schedule
$environment  <key>StandardOutPath</key>
  <string>$log_dir/$label.log</string>
  <key>StandardErrorPath</key>
  <string>$log_dir/$label.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
PLIST
  plutil -lint -s "$agents/$label.plist"
  launchctl bootout "$domain/$label" 2>/dev/null || true
  # bootout can return before launchd has removed the old job, and bootstrap
  # then fails with "5: Input/output error" (seen 2026-10-13), so retry.
  tries=1
  until launchctl bootstrap "$domain" "$agents/$label.plist" 2>/dev/null; do
    if [ "$tries" -ge 10 ]; then
      launchctl bootstrap "$domain" "$agents/$label.plist"
      return
    fi
    tries=$((tries + 1))
    sleep 1
  done
}

write_agent com.jubishop.radio.run "  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>" run --logs "$log_dir"
write_agent com.jubishop.radio.serve "  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>" serve

echo "Installed $bin_dir/radio and loaded com.jubishop.radio.run and com.jubishop.radio.serve."
echo "Logs: $log_dir. Alerts link to ${dashboard_url:-http://jubi.local:8102}."
